[Unit]
Description=Telephony Background Service
After=graphical-session.target
BindsTo=graphical-session.target
PartOf=graphical-session.target
OnFailure=telephony-failed.service

[Service]
Type=dbus
BusName=io.furios.Telephony.Daemon
Environment=MALLOC_ARENA_MAX=2

# Start App
ExecStart=/usr/libexec/telephony-server

Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
