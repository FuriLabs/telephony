msgstr "Nastavenia boli uložené"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/sound_recorder_window.py:40
msgid "Voice Message"
msgstr "Hlasová správa"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/sound_recorder_window.py:91
msgid "Tap to Record"
msgstr "Klepnutím zaznamenáte"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/sound_recorder_window.py:137
