msgstr "Ilmoituspoikkeukset"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:291
#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:456
msgid "Repeated Calls Bypass"
msgstr "Toistuvien puheluiden läpipääsy"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:293
msgid "If the same number calls 3 times in 5 minutes, force max volume."
msgstr ""
"Jos sama numero soittaa 3 kertaa 5 minuutissa, puhelin hälyttää täysillä."

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:308
msgid "Manage contacts that always play sound"
msgstr "Hallitse yhteystietoja, jotka hälyttävät aina"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:317
#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:329
#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:340
msgid "Manage"
msgstr "Hallitse"

