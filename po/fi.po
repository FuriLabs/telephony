#: src/telephony/client/ui/windows/network_services_window.py:361
msgid "Disable All Forwarding"
msgstr "Poista kaikki soitonsiirrot käytöstä"

#: src/telephony/client/ui/windows/network_services_window.py:117
#: src/telephony/client/ui/windows/network_services_window.py:118
msgid "Call Waiting"
msgstr "Koputus"

#: src/telephony/client/ui/windows/network_services_window.py:119
msgid ""
"When enabled, a second incoming call beeps during an ongoing call instead of "
"the caller getting a busy signal."
msgstr "Kun tämä on käytössä, toinen saapuva puhelu antaa äänimerkin käynnissä olevan puhelun aikana sen sijaan, että soittaja saisi varattu-äänen."

#: src/telephony/client/ui/windows/network_services_window.py:127
msgid "Network Default"
msgstr "Verkon oletus"

#: src/telephony/client/ui/windows/network_services_window.py:129
msgid "Shown"
msgstr "Näytetään"

#: src/telephony/client/ui/windows/network_services_window.py:131
#: src/telephony/client/ui/windows/network_services_window.py:133
msgid "Hide Caller ID"
msgstr "Piilota soittajan tunnus"

#: src/telephony/client/ui/windows/network_services_window.py:134
msgid ""
"Choose whether people you call see your number. Network Default follows your "
"subscription setting. Hiding can also be chosen for a single call from a "
"contact's call menu."
msgstr "Valitse, näkevätkö soittamasi henkilöt numerosi. Verkon oletus seuraa liittymäsi asetusta. Piilotuksen voi valita myös yksittäiselle puhelulle yhteystiedon puheluvalikosta."

#: src/telephony/client/ui/windows/network_services_window.py:142
#: src/telephony/client/ui/windows/network_services_window.py:148
msgid "Call Barring"
msgstr "Puheluiden esto"

#: src/telephony/client/ui/windows/network_services_window.py:143
msgid ""
"Barring blocks whole classes of calls in the network.\n"
"\n"
"Every change needs the barring password from your operator, often 0000 by "
"default. Repeated wrong attempts can lock barring at the network side, in "
"which case only your operator can unlock it."
msgstr "Esto estää kokonaisia puheluluokkia verkossa.\n\nJokainen muutos vaatii operaattorilta saadun eston salasanan, joka on usein oletuksena 0000. Toistuvat väärät yritykset voivat lukita eston verkon puolella, jolloin vain operaattorisi voi avata sen."

#: src/telephony/client/ui/windows/network_services_window.py:152
#: src/telephony/client/ui/windows/network_services_window.py:164
