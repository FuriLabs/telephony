#: src/telephony/ui/windows/settings_window.py:627
#, python-brace-format
msgid ""
"Enter the URL you want to use for searching unknown numbers. Include "
"'{number}' in the URL where the caller's phone number should go.\n"
"\n"
"For example: https://mysearch.com/?q={number}\n"
"\n"
"When you tap the search button during a call, we will replace '{number}' "
"with the actual phone number and open it in your default browser."
msgstr ""
"Cuir isteach an URL is mian leat a úsáid chun uimhreacha anaithnide a "
"chuardach. Cuir '{number}' san URL áit ar cheart uimhir theileafóin an "
"ghlaoiteora a chur.\n"
"\n"
"Mar shampla: https://mysearch.com/?q={number}\n"
"\n"
"Nuair a chliceálann tú an cnaipe cuardaigh le linn glao, cuirfimid an uimhir "
"theileafóin iarbhír in ionad '{number}' agus osclóidh tú é i do bhrabhsálaí "
"réamhshocraithe."

#: src/telephony/ui/windows/settings_window.py:631
msgid "Custom Search URL"
msgstr "URL Cuardach Saincheaptha"

