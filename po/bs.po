#: src/telephony/ui/windows/settings_window.py:617
#, python-brace-format
msgid ""
"Enter the URL you want to use for searching unknown numbers. Include "
"'{number}' in the URL where the caller's phone number should go.\n"
"\n"
"For example: https://mysearch.com/?q={number}\n"
"\n"
"When you tap the search button during a call, we will replace '{number}' "
"with the actual phone number and open it in your default browser."
msgstr ""
"Unesite URL koji želite koristiti za pretraživanje nepoznatih brojeva. "
"Uključite ' {number} ' u URL na koji treba da ide telefonski broj "
"pozivaoca.\n"
"\n"
"Na primjer: https://mysearch.com/?q= {number} Kada dodirnete dugme za "
"pretragu tokom poziva, zamenit ćemo ' {number} ' stvarnim telefonskim brojem "
"i otvoriti ga u vašem podrazumevanom pretraživaču."

