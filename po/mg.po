msgstr "Bokotra fikarohana ho an'ny miantso tsy fantatra mandritra ny antso"

#: src/telephony/client/ui/windows/settings_window.py:691
msgid "Used by the search buttons in calls, call history and group messages."
msgstr "Ampiasain'ny bokotra fikarohana ao amin'ny antso, ny tantaran'ny antso sy ny hafatra an-tarika."

#: src/telephony/client/ui/windows/settings_window.py:695
msgid "Search Engine"
