msgstr "Se la sama numero vokas 3-foje en 5 minutoj, sonigu maksimume laŭte."

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:308
msgid "Manage contacts that always play sound"
msgstr "Administri kontaktojn, kiuj ĉiam sonas"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:317
