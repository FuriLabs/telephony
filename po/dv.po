msgstr "އަމިއްލަ ސާޗް ލިންކު"

#: src/telephony/ui/windows/settings_window.py:660
msgid "Desktop Shortcuts"
msgstr "ޑެސްކްޓޮޕް ޝޯޓްކަޓްތައް"

#: src/telephony/ui/windows/settings_window.py:665
msgid "Calls"
msgstr "ކޯލްތައް"

#: src/telephony/ui/windows/settings_window.py:831
msgid "Name (e.g. Mom)"
msgstr "ނަން (މިސާލަކަށް މަންމަ)"

#: src/telephony/ui/windows/settings_window.py:888
msgid ""
"This is the call volume for each output. The level applies automatically "
"when a call connects and whenever the output changes during a call, and "
"slider changes are heard live. The hardware applies levels in coarse steps, "
"and the earpiece never goes fully silent. The Bluetooth level is stored for "
"upcoming routing support."
msgstr ""
"މިއީ ކޮންމެ އައުޓްޕުޓަކަށް ކޯލްގެ އަޑުގެ މިންވަރެވެ. ކޯލެއް ގުޅުމުން އަދި ކޯލެއްގެ ތެރޭގައި އައުޓްޕުޓް ބަދަލުވާ ކޮންމެ ފަހަރަކު މި "
"މިންވަރު އޮޓޮމެޓިކުން ބޭނުންކުރެވެއެވެ، އަދި ސްލައިޑަރުގެ ބަދަލުތައް ވަގުތުން އިވޭނެއެވެ. ހާޑްވެއާއިން މިންވަރުތައް ބޮޑެތި ފިޔަވަޅުތަކުން "
"ބޭނުންކުރެއެވެ، އަދި ކަންފަތު ސްޕީކަރު ދުވަހަކުވެސް އެއްކޮށް ހިމޭނެއް ނުވާނެއެވެ. Bluetooth ގެ މިންވަރު ކުރިއަށް އޮތް ރައުޓިން "
"ސަޕޯޓަށް ރައްކާކުރެވެއެވެ."

