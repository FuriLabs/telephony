#~ msgstr "މައިކް ބަންދުކުރޭ"

#~ msgid "Failed to send to {number}"
#~ msgstr "{number} އަށް ފޮނުވޭގޮތެއް ނުވި"

#~ msgid "Delete Custom Settings"
#~ msgstr "އަމިއްލަ ސެޓިންގްސް ފޮހެލާ"

#~ msgid "Delete Settings"
#~ msgstr "ސެޓިންގްސް ފޮހެލާ"

#~ msgid "Clear all custom settings? Emergency numbers will be lost."
