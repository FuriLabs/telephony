msgid "Regenerate"
msgstr "Wygeneruj ponownie"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/trusted_actions_list_window.py:651
msgid "Remove current TOTP"
msgstr "Usuń aktualny TOTP"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/trusted_actions_list_window.py:660
msgid "Remove TOTP Key?"
msgstr "Usunąć klucz TOTP?"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/trusted_actions_list_window.py:661
msgid ""
"Are you sure you want to remove the TOTP key? This action will disable TOTP "
"verification for this feature."
msgstr ""
"Czy na pewno chcesz usunąć klucz TOTP? Ta czynność wyłączy weryfikację TOTP "
"dla tej funkcji."

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/trusted_actions_list_window.py:681
msgid "Regenerate Code?"
msgstr "Wygenerować kod ponownie?"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/trusted_actions_list_window.py:682
msgid ""
"This will invalidate the current code in your contact's authenticator app. "
"Are you sure?"
msgstr ""
"Spowoduje to unieważnienie aktualnego kodu w aplikacji uwierzytelniającej "
"kontaktu. Jesteś pewien?"

