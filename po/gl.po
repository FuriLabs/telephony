msgstr ""
"Esta é a axenda de enderezos que se sincronizará con Andrómeda se escolles "
"facelo na configuración do sistema."

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:929
msgid "Andromeda Contacts"
msgstr "Contactos de Andrómeda"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:930
msgid ""
"This is the address book that will be synced from Andromeda if you choose to "
"do so in System Settings."
msgstr ""
"Esta é a axenda de enderezos que se sincronizará desde Andromeda se escolles "
"facelo na configuración do sistema."

