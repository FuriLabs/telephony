msgstr "Restrinxir as chamadas internacionais"

#: src/telephony/client/ui/windows/network_services_window.py:155
msgid "Bar International Except Home"
msgstr "Restrinxir as internacionais agás ao país propio"

#: src/telephony/client/ui/windows/network_services_window.py:158
msgid "Outgoing Calls"
msgstr "Chamadas saíntes"

#: src/telephony/client/ui/windows/network_services_window.py:166
msgid "Bar When Roaming"
msgstr "Restrinxir en itinerancia"

#: src/telephony/client/ui/windows/network_services_window.py:169
