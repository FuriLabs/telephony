msgstr "Qué hacer con los desconocidos"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:486
msgid "Applies also to hidden numbers."
msgstr "También para los números ocultos."

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:489
