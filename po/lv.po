#~ msgid ""
#~ "Carriers limit how large a multimedia message can be. Images and videos "
#~ "you attach are automatically compressed to fit under this limit before "
#~ "sending.\n"
#~ "\n"
#~ "Automatic uses the limit reported by the phone's MMS service, which is "
#~ "right for most carriers. Pick a smaller value if your messages fail to "
#~ "send, or a larger one if you know your carrier allows it."
#~ msgstr ""
#~ "Operatori ierobežo, cik liela var būt multivides ziņa. Pievienotie attēli "
#~ "un video pirms nosūtīšanas tiek automātiski saspiesti, lai iekļautos šajā "
#~ "ierobežojumā.\n"
#~ "\n"
#~ "Automātiski izmanto ierobežojumu, ko ziņo tālruņa MMS pakalpojums, un tas "
#~ "ir piemērots lielākajai daļai operatoru. Izvēlieties mazāku vērtību, ja "
#~ "ziņas neizdodas nosūtīt, vai lielāku, ja zināt, ka jūsu operators to "
#~ "atļauj."

#~ msgid ""
#~ "Trusted contacts can wipe your device. TOTP is mandatory for this feature "
#~ "to work. Add contacts below and set their secret trigger phrase. Example "
#~ "template: 'SECRET TOTP SIM_CURRENT_PIN SIM_NEW_PIN SUDO_PASSWORD' Real "
#~ "life example: 'Gorilla 123456 0000 1234 SupportYourLocalFootball'"
#~ msgstr ""
#~ "Uzticamās kontaktpersonas var dzēst jūsu ierīci. Lai šī funkcija "
#~ "darbotos, ir nepieciešams TOTP. Tālāk pievienojiet kontaktpersonas un "
#~ "iestatiet viņu slepeno palaišanas frāzi. Veidnes piemērs: 'SECRET TOTP "
#~ "SIM_CURRENT_PIN SIM_NEW_PIN SUDO_PASSWORD' Reālās dzīves piemērs: "
#~ "'Gorilla 123456 0000 1234 SupportYourLocalFootball'"

