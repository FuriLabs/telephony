#~ msgid ""
#~ "When the modem stops responding, the phone quietly runs the recovery "
#~ "steps by itself: phone service restart, radio restart, modem power cycle, "
#~ "firmware restart and re-enabling a disabled radio. The phone is never "
#~ "rebooted automatically. If nothing helps you are asked to reboot. When "
#~ "this is off, the Modem Recovery window opens instead so you can run the "
#~ "steps yourself."
#~ msgstr ""
#~ "Kad modems pārstāj reaģēt, tālrunis klusi pats veic atkopšanas soļus: "
#~ "tālruņa pakalpojuma restartēšanu, radio restartēšanu, modema barošanas "
#~ "ciklu, programmaparatūras restartēšanu un atspējota radio atkārtotu "
#~ "ieslēgšanu. Tālrunis nekad netiek restartēts automātiski. Ja nekas "
#~ "nepalīdz, jums tiek lūgts restartēt tālruni. Kad šis iestatījums ir "
#~ "izslēgts, tā vietā tiek atvērts modema atkopšanas logs, lai jūs varētu "
#~ "veikt soļus pats."

