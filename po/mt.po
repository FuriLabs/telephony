msgstr "Il-modem qed jerġa' jibda…"

#: src/telephony/client/ui/windows/advanced_settings_window.py:414
msgid "Calls and messages work again"
msgstr "Is-sejħiet u l-messaġġi qed jaħdmu mill-ġdid"

#: src/telephony/client/ui/windows/advanced_settings_window.py:415
