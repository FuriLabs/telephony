msgid "Exported {count} messages to Chatty database."
msgstr "Извезено {count} порука у Chatty базу података."

#: src/telephony/client/utils/exporter_local_utils.py:257
msgid "Exported {count} calls to Gnome Calls database."
msgstr "Извезено {count} позива у базу података Gnome позива."

#: src/telephony/client/utils/exporter_local_utils.py:269
msgid "Source database not found."
msgstr "Изворна база података није пронађена."

#: src/telephony/client/utils/exporter_local_utils.py:272
msgid "Exported Telephony database successfully."
msgstr "База података телефоније је успешно извезена."

#: src/telephony/client/utils/model_utils.py:24
msgid "Incoming"
msgstr "Долазни"

#: src/telephony/client/utils/model_utils.py:26
msgid "Outgoing"
msgstr "Излазни"

#: src/telephony/client/utils/model_utils.py:33
msgid "Declined at the other end"
msgstr "Одбијен на другој страни"

#: src/telephony/client/utils/model_utils.py:35
