msgstr ""
"Dit is die adresboek wat vanaf Andromeda gesinkroniseer sal word as jy dit "
"in Stelselinstellings kies."

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:1055
msgid "Settings Saved"
msgstr "Instellings Gestoor"

