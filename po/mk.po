msgstr "Извезени {count} пораки во базата на податоци Chatty."

#: src/telephony/client/utils/exporter_local_utils.py:257
#, python-brace-format
msgid "Exported {count} calls to Gnome Calls database."
msgstr "Извезени {count} повици во базата на податоци Gnome Calls."

