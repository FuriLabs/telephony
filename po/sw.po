#: src/telephony/ui/windows/settings_window.py:572
#: src/telephony/ui/windows/settings_window.py:577
msgid "Custom URL"
msgstr "URL Maalum"

#: src/telephony/ui/windows/settings_window.py:627
#, python-brace-format
msgid ""
"Enter the URL you want to use for searching unknown numbers. Include "
"'{number}' in the URL where the caller's phone number should go.\n"
"\n"
"For example: https://mysearch.com/?q={number}\n"
"\n"
"When you tap the search button during a call, we will replace '{number}' "
"with the actual phone number and open it in your default browser."
msgstr ""
"Weka URL unayotaka kutumia kutafuta nambari zisizojulikana. Jumuisha "
"'{number}' katika URL ambapo nambari ya simu ya mpiga simu inapaswa kwenda.\n"
"\n"
"Kwa mfano: https://mysearch.com/?q={number}\n"
"\n"
"Unapogonga kitufe cha kutafuta wakati wa simu, tutabadilisha '{number}' na "
"nambari halisi ya simu na kuifungua katika kivinjari chako chaguomsingi."

#: src/telephony/ui/windows/settings_window.py:631
msgid "Custom Search URL"
msgstr "URL Maalum ya Utafutaji"

#: src/telephony/ui/windows/settings_window.py:652
msgid "Desktop Shortcuts"
msgstr "Njia za mkato za Eneo-kazi"

#: src/telephony/ui/windows/settings_window.py:657
msgid "Calls"
