#: src/telephony/ui/windows/settings_window.py:574
#, python-brace-format
msgid ""
"Enter the URL you want to use for searching unknown numbers. Include "
"'{number}' in the URL where the caller's phone number should go.\n"
"\n"
"For example: https://mysearch.com/?q={number}\n"
"\n"
"When you tap the search button during a call, we will replace '{number}' "
"with the actual phone number and open it in your default browser."
msgstr ""
"ئەو URL داخڵ بکە کە دەتەوێت بۆ گەڕان بەدوای ژمارە نەناسراوەکاندا بەکاری "
"بهێنیت. ' {number} ' لە URLەکەدا دابنێ کە ژمارەی تەلەفۆنی پەیوەندیکەرەکە "
"دەبێت بچێتە ئەوێ.\n"
"\n"
"بۆ نموونە: https://mysearch.com/?q= {number} کاتێک لە کاتی پەیوەندیکردندا "
"دوگمەی گەڕانەکەت لێدەدەیت، ئێمە ' {number} ' بە ژمارەی تەلەفۆنی ڕاستەقینە "
"دەگۆڕین و لە وێبگەڕی پێشوەختەدا دەیکەینەوە."

#: src/telephony/ui/windows/settings_window.py:578
msgid "Custom Search URL"
msgstr "URL ی گەڕانی تایبەتمەند"

#: src/telephony/ui/windows/settings_window.py:599
