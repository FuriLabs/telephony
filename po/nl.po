msgid "Do Nothing"
msgstr "Doe niets"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:490
msgid "Block Completely"
msgstr "Blokkeer volledig"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:491
msgid "Silence and Hide UI"
msgstr "Stilte en verberg gebruikersinterface"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:492
msgid "Silence Only"
msgstr "Alleen stilte"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:500
msgid "Add Search button to InCall window and Call History for unknown callers"
msgstr ""
"Voeg de zoekknop toe aan het InCall-venster en de oproepgeschiedenis voor "
"onbekende bellers"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:506
msgid "Search Engine"
msgstr "Zoekmachine"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:510
#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:515
msgid "Custom URL"
msgstr "Aangepaste URL"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:565
#, python-brace-format
msgid ""
"Enter the URL you want to use for searching unknown numbers. Include "
"'{number}' in the URL where the caller's phone number should go.\n"
"\n"
"For example: https://mysearch.com/?q={number}\n"
"\n"
"When you tap the search button during a call, we will replace '{number}' "
"with the actual phone number and open it in your default browser."
msgstr ""
"Voer de URL in die je wilt gebruiken voor het zoeken naar onbekende nummers. "
"Neem '{number}' op in de URL waar het telefoonnummer van de beller naartoe "
"moet gaan.\n"
"\n"
"Bijvoorbeeld: https://mysearch.com/?q={number}\n"
"\n"
"Wanneer je tijdens een gesprek op de zoekknop tikt, vervangen we '{number}' "
"door het daadwerkelijke telefoonnummer en openen we dit in jouw "
"standaardbrowser."

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:569
msgid "Custom Search URL"
msgstr "Aangepaste zoek-URL"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:590
msgid "Desktop Shortcuts"
msgstr "Bureaubladsnelkoppelingen"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:595
msgid "Calls"
msgstr "Oproepen"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:761
msgid "Name (e.g. Mom)"
msgstr "Naam (bijvoorbeeld mama)"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:806
msgid ""
"This is the call volume for each output. The level applies automatically "
"when a call connects and whenever the output changes during a call, and "
"slider changes are heard live. The hardware applies levels in coarse steps, "
"and the earpiece never goes fully silent. The Bluetooth level is stored for "
"upcoming routing support."
msgstr ""
"Dit is het gespreksvolume voor elke uitvoer. Het niveau wordt automatisch "
"toegepast wanneer een oproep wordt verbonden en telkens wanneer de uitvoer "
"tijdens een gesprek verandert, en wijzigingen van de schuifregelaar zijn "
"direct te horen. De hardware past niveaus in grove stappen toe, en de "
"oorluidspreker wordt nooit helemaal stil. Het Bluetooth-niveau wordt "
"opgeslagen voor toekomstige routeringsondersteuning."

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:815
msgid "Decline Message"
msgstr "Bericht weigeren"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:886
msgid "System Default (Always Enabled)"
msgstr "Systeemstandaard (altijd ingeschakeld)"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:897
msgid "Personal Address Book"
msgstr "Persoonlijk adresboek"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:898
msgid ""
"This is the address book that will be synced to Andromeda if you choose to "
"do so in System Settings."
msgstr ""
"Dit is het adresboek dat met Andromeda wordt gesynchroniseerd als je "
"daarvoor kiest in Systeeminstellingen."

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:906
msgid "Andromeda Contacts"
msgstr "Andromeda-contacten"

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:907
msgid ""
"This is the address book that will be synced from Andromeda if you choose to "
"do so in System Settings."
msgstr ""
"Dit is het adresboek dat vanuit Andromeda wordt gesynchroniseerd als je "
"daarvoor kiest in Systeeminstellingen."

#: /home/alaraajavamma/claude/telephony/src/telephony/ui/windows/settings_window.py:1032
msgid "Settings Saved"
msgstr "Instellingen opgeslagen"

