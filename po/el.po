msgstr "Αριθμοί έκτακτης ανάγκης του δικτύου"

#: src/telephony/client/ui/windows/settings_window.py:408
msgid "Show Numbers From Network"
msgstr "Εμφάνιση αριθμών από το δίκτυο"

#: src/telephony/client/ui/windows/settings_window.py:422
#: src/telephony/client/ui/windows/settings_window.py:853
msgid "Request Delivery Reports"
msgstr "Αίτηση αναφορών παράδοσης"

#: src/telephony/client/ui/windows/settings_window.py:431
msgid "Show Numbers In Message List"
msgstr "Εμφάνιση αριθμών στη λίστα μηνυμάτων"

#: src/telephony/client/ui/windows/settings_window.py:432
msgid ""
"Off keeps numbers off the list; one with no contact shows its number as the "
"name"
msgstr "Το ανενεργό κρατά τους αριθμούς εκτός λίστας· ένας χωρίς επαφή εμφανίζει τον αριθμό του ως όνομα"

#: src/telephony/client/ui/windows/settings_window.py:449
msgid "Address Book Info"
msgstr "Πληροφορίες βιβλίου διευθύνσεων"

#: src/telephony/client/ui/windows/settings_window.py:456
msgid "Default Address Book"
msgstr "Προεπιλεγμένο βιβλίο"

#: src/telephony/client/ui/windows/settings_window.py:460
msgid "Duplicate Resolver"
msgstr "Επίλυση διπλότυπων"

#: src/telephony/client/ui/windows/settings_window.py:462
msgid ""
"Scan for duplicate numbers and show a resolution banner in the Contacts view."
msgstr "Ψάξε για διπλούς αριθμούς και δείξε ειδοποίηση στις επαφές."

#: src/telephony/client/ui/windows/settings_window.py:471
