msgid "Please wait 60 seconds before triggering {prefix} again."
msgstr "{prefix} ஐ மீண்டும் தூண்டுவதற்கு முன் 60 வினாடிகள் காத்திருக்கவும்."

#: src/telephony/daemon/managers/ofono_manager.py:1930
msgid " (Accuracy: {acc}m)"
msgstr "(துல்லியம்: {acc}m)"

#: src/telephony/daemon/managers/ofono_manager.py:1932
msgid "I am here: {link}{acc_str}"
msgstr "நான் இங்கே இருக்கிறேன்: {link}{acc_str}"

#: src/telephony/daemon/managers/ofono_manager.py:1940
msgid "Failed to obtain location after trying all methods."
msgstr "எல்லா முறைகளையும் முயற்சித்தும் இருப்பிடத்தைப் பெற முடியவில்லை."

#: src/telephony/daemon/telephony_core.py:376
msgid "The radio is switched off. Turn it back on to use the modem."
msgstr "வானொலி அணைக்கப்பட்டுள்ளது. மோடத்தைப் பயன்படுத்த அதை மீண்டும் இயக்குங்கள்."

#: src/telephony/daemon/telephony_core.py:377
msgid ""
"This device reports no modem. Restarting cannot fix a modem that is missing "
"or has no identity."
msgstr "இந்தச் சாதனம் மோடம் இல்லை என்று தெரிவிக்கிறது. இல்லாத அல்லது தன்னைப் பற்றிய தரவு இல்லாத மோடத்தை மீண்டும் தொடங்குவதால் சரிசெய்ய முடியாது."

#: src/telephony/daemon/telephony_core.py:401
msgid "The modem service is not responding."
msgstr "மோடம் சேவை பதிலளிக்கவில்லை."

#: src/telephony/daemon/telephony_core.py:403
msgid "The modem is answering, but it lost its calling service."
msgstr "மோடம் பதிலளிக்கிறது, ஆனால் அதன் அழைப்புச் சேவையை இழந்துவிட்டது."

#: src/telephony/daemon/telephony_core.py:405
msgid "The modem is answering, but its radio is switched off."
msgstr "மோடம் பதிலளிக்கிறது, ஆனால் அதன் வானொலி அணைக்கப்பட்டுள்ளது."

#: src/telephony/daemon/telephony_core.py:485
msgid "Network registration denied"
msgstr "நெட்வொர்க் பதிவு மறுக்கப்பட்டது"

#: src/telephony/daemon/telephony_core.py:486
msgid "The network rejected this SIM. Contact your operator."
msgstr "நெட்வொர்க் இந்த சிம்மை நிராகரித்தது. உங்கள் இயக்குநரைத் தொடர்பு கொள்ளவும்."

#: src/telephony/daemon/telephony_core.py:503
msgid "SIM PIN required"
msgstr "சிம் பின் தேவை"

#: src/telephony/daemon/telephony_core.py:504
msgid "Calls and messages stay offline until the SIM is unlocked."
msgstr "சிம் திறக்கப்படும் வரை அழைப்புகளும் செய்திகளும் ஆஃப்லைனில் இருக்கும்."

#: src/telephony/daemon/telephony_core.py:609
#: src/telephony/daemon/telephony_core.py:643
msgid "Call Back"
msgstr "மீண்டும் அழைக்கவும்"

#: src/telephony/daemon/telephony_core.py:636
msgid "Missed Call"
msgstr "தவறிய அழைப்பு"

